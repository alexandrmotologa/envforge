{
  "name": "envforge",
  "version": "1.0.0",
  "description": "Cross-environment configuration parity auditor and drift detector with AST source scanning and type-safe Zod schema generation.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "envforge": "bin/envforge.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:web",
    "build:cli": "tsc -p tsconfig.json",
    "build:web": "npm --prefix web run build",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "configuration-management",
    "environment-variables",
    "drift-detection",
    "secret-detection",
    "dotenv",
    "docker-compose",
    "kubernetes-secrets",
    "terraform-vars",
    "ast-analysis",
    "zod-schema",
    "react19",
    "devtools"
  ],
  "author": "Alexandr Motologa",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.26.9",
    "@babel/traverse": "^7.26.9",
    "@babel/types": "^7.26.9",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "fast-glob": "^3.3.3",
    "fastify": "^5.2.1",
    "picocolors": "^1.1.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
